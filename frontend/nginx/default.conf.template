# Ingat.in — nginx (SPA + proxy API)
#
# Template ini diproses oleh docker-entrypoint nginx: placeholder ${...}
# digantikan saat container start (lihat /etc/nginx/templates/*.template
# pada image nginx resmi).
#
# - INGATIN_WEB_PORT      : port listen nginx (default 8091)
# - INGATIN_API_UPSTREAM  : alamat backend API (default http://api:8081).
#   Pada Mode B (semua service di bridge network) nilai default sudah benar
#   karena nginx menjangkau service `api` lewat DNS internal Compose.
#   Nilai ini dapat ditimpa bila backend dijalankan di host lain.
#
# Port listen ditentukan INGATIN_WEB_PORT (bukan 80) agar di dalam container
# tidak memerlukan hak root dan tidak berkonflik dengan nginx host.

server {
    listen ${INGATIN_WEB_PORT} default_server;
    listen [::]:${INGATIN_WEB_PORT} default_server;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Kompresi
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
    gzip_min_length 512;

    # Header keamanan
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    # Aset statis ber-hash: cache panjang.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # API diteruskan ke backend (service `api` lewat DNS internal Compose).
    location /api/ {
        proxy_pass ${INGATIN_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_connect_timeout 10s;
        proxy_read_timeout    60s;
        proxy_send_timeout    60s;

        add_header Cache-Control "no-store" always;
    }

    # SPA fallback: semua rute diarahkan ke index.html.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
    }

    location = /index.html {
        add_header Cache-Control "no-store" always;
    }
}
