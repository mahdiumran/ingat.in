# ===========================================================================
# Ingat.in — contoh konfigurasi (Mode B: PostgreSQL container)
#
# Salin menjadi .env lalu isi nilai-nilainya:
#   cp .env.example .env && chmod 600 .env
#
# Cara membuat secret acak:
#   openssl rand -hex 32                    -> INGATIN_SECRET_KEY
#   openssl rand -base64 24 | cut -c1-32    -> INGATIN_CREDENTIAL_KEY (tepat 32 byte)
#   openssl rand -hex 20                    -> password database / WAHA API key
#
# CATATAN: ./install.sh mengisi file .env secara otomatis dengan nilai acak.
#          Cara termudah: jalankan ./install.sh (tanpa file .env).
# ===========================================================================

# ---------------------------------------------------------------------------
# Umum
# ---------------------------------------------------------------------------
INGATIN_APP_NAME=Ingat.in
INGATIN_APP_VERSION=dev
# Mode diisi otomatis oleh docker-compose (api / worker / migrate).
INGATIN_MODE=api
# Alamat API di DALAM container. Compose menimpa ini menjadi 0.0.0.0:8081.
INGATIN_ADDR=0.0.0.0:8081
INGATIN_LOG_LEVEL=info
INGATIN_TIMEZONE=Asia/Jakarta
INGATIN_DATA_DIR=/app/data
# Origin frontend untuk CORS. Ganti ke http://<IP-SERVER>:8091 bila diakses
# dari LAN, atau https://domain bila memakai reverse proxy/TLS.
INGATIN_FRONTEND_ORIGIN=http://localhost:8091
# Daftar IP/CIDR reverse proxy yang dipercaya (opsional, pisahkan dengan koma).
INGATIN_TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# Port host (ubah bila bentrok dengan service lain di server)
# ---------------------------------------------------------------------------
INGATIN_WEB_PORT=8091
INGATIN_API_PORT=8081
INGATIN_WAHA_PORT=8082
# Port PostgreSQL di host (container selalu 5432 di dalam).
INGATIN_PG_PORT=5432

# ---------------------------------------------------------------------------
# Keamanan (WAJIB diganti)
# ---------------------------------------------------------------------------
# Signing JWT. Minimal 32 karakter acak.
INGATIN_SECRET_KEY=ganti_dengan_openssl_rand_hex_32
# Kunci AES-256-GCM untuk enkripsi API key provider.
# HARUS TEPAT 32 KARAKTER, jika tidak aplikasi akan menolak start.
INGATIN_CREDENTIAL_KEY=ganti_tepat_32_karakter_xxxxx

# ---------------------------------------------------------------------------
# Database (Mode B: PostgreSQL container — host = nama service `postgres`)
# ---------------------------------------------------------------------------
INGATIN_DB_URL=postgres://ingatin:GANTI_PASSWORD@postgres:5432/ingatin?sslmode=disable
INGATIN_DB_NAME=ingatin
INGATIN_DB_USER=ingatin
INGATIN_DB_PASSWORD=GANTI_PASSWORD

# ---------------------------------------------------------------------------
# Sesi
# ---------------------------------------------------------------------------
# 4320 menit = 72 jam (3 hari), sesuai keputusan desain.
INGATIN_ACCESS_TOKEN_MINUTES=4320
INGATIN_REFRESH_TOKEN_DAYS=30
# 0 = idle timeout nonaktif.
INGATIN_SESSION_IDLE_TIMEOUT_MINUTES=0

# ---------------------------------------------------------------------------
# Admin awal (dibuat saat bootstrap bila belum ada)
# ---------------------------------------------------------------------------
INGATIN_ADMIN_USERNAME=admin
INGATIN_ADMIN_EMAIL=
# WAJIB diisi; ganti setelah login pertama.
INGATIN_ADMIN_PASSWORD=GANTI_PASSWORD_ADMIN

# ---------------------------------------------------------------------------
# WAHA — WhatsApp gateway
# ---------------------------------------------------------------------------
# Host = nama service `waha` (port internal container 3000).
INGATIN_WAHA_BASE_URL=http://waha:3000
INGATIN_WAHA_API_KEY=GANTI_WAHA_API_KEY
# URL dashboard QR yang ditampilkan di panel (nginx :8010 dengan basic auth).
# Kosongkan bila tidak memakai situs QR nginx.
INGATIN_WAHA_QR_URL=
# Engine: WEBJS (bawaan) atau GOWS (lebih hemat memori, tanpa Chromium).
WAHA_ENGINE=WEBJS
WAHA_API_KEY=GANTI_WAHA_API_KEY
WAHA_DASHBOARD_USERNAME=noc
WAHA_DASHBOARD_PASSWORD=GANTI_DASHBOARD_PASSWORD

# ---------------------------------------------------------------------------
# Notifikasi (nilai awal; dapat diubah dari panel)
# ---------------------------------------------------------------------------
INGATIN_OUTBOX_BATCH_SIZE=50
INGATIN_OUTBOX_MAX_ATTEMPTS=5
INGATIN_OUTBOX_SENDER_INTERVAL_SECONDS=15
INGATIN_FANOUT_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# Telegram command bot (F12, inbound)
# ---------------------------------------------------------------------------
# Secret pengaman webhook. Bot AKTIF hanya bila nilai ini diisi.
# Endpoint: POST https://<host>/api/hooks/telegram/<secret>
# Daftar grup Telegram yang diizinkan TIDAK di sini, melainkan di panel
# Master Data → "Grup Telegram Bot" (admin). Kirim /id di grup untuk melihat
# chat_id lalu tambahkan sebagai entri baru (Kode = chat_id).
#
# Daftarkan webhook (sekali):
#   curl -s "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#     -d "url=https://<host>/api/hooks/telegram/<secret>" \
#     -d "secret_token=<secret>"
INGATIN_TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Retensi (hari)
# ---------------------------------------------------------------------------
INGATIN_AUDIT_RETENTION_DAYS=90
INGATIN_OUTBOX_RETENTION_DAYS=90
INGATIN_BACKUP_KEEP_DAYS=14
INGATIN_RETENTION_INTERVAL_HOURS=24

# ---------------------------------------------------------------------------
# Cadangan / Backup (F34)
# ---------------------------------------------------------------------------
# Direktori penyimpanan berkas cadangan (default: <INGATIN_DATA_DIR>/backups).
# Kosongkan untuk memakai default.
INGATIN_BACKUP_DIR=
# Aktifkan cadangan otomatis dari worker. Jadwal & konfigurasi FTP dapat diubah
# dari panel admin (Menu Manajemen → Backup & Restore) tanpa deploy ulang.
INGATIN_BACKUP_AUTO_ENABLED=false
# Ekspresi cron 5-kolom untuk jadwal cadangan otomatis (waktu server).
INGATIN_BACKUP_SCHEDULE="0 2 * * *"

# ---------------------------------------------------------------------------
# Sinkronisasi Google Spreadsheet (F18)
# ---------------------------------------------------------------------------
# Interval worker menulis antrean sinkronisasi ke spreadsheet (detik).
# Spreadsheet ID, nama sheet, dan kredensial service account diisi dari
# panel admin (Integrations → Google Sheets), BUKAN dari file ini.
INGATIN_SHEET_SYNC_INTERVAL_SECONDS=30

# ---------------------------------------------------------------------------
# Lampiran pendukung tiket (F21)
# ---------------------------------------------------------------------------
# Ukuran maksimum per berkas (MB).
INGATIN_ATTACHMENTS_MAX_MB=50
# Jenis MIME yang diizinkan (dipisah koma). Wildcard seperti image/* didukung.
INGATIN_ATTACHMENTS_ALLOWED_TYPES=image/png,image/jpeg,image/jpg,image/gif,image/webp,application/pdf,text/plain,text/csv,application/zip,application/gzip
